# Copy to .env and fill in.

# Claude API key for sentiment analysis (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model used for sentiment classification
SENTIMENT_MODEL=claude-haiku-4-5-20251001

# Run browsers headless (true) or visible (false). Use false when solving captchas.
HEADLESS=true

# Max reviews to crawl per job (safety cap)
MAX_REVIEWS=100

# Directories
SESSION_DIR=data/sessions
SCREENSHOT_DIR=data/screenshots

# --- Instagram analysis pipeline (execution/) ---
# Apify API token (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=
# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Optional: Apify actor id (default apify/instagram-post-scraper)
APIFY_ACTOR_ID=apify/instagram-post-scraper
# Optional: Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional: max posts to scrape/analyze per run (default 30)
RESULTS_LIMIT=30
